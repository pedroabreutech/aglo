# Exemplo de variáveis de ambiente (NÃO comitar segredos)
# Copie para `.env` e adicione valores reais locais. `.env` deve ficar em .gitignore

# Ambiente da aplicação
NODE_ENV=dev

# URL server-side da API do backend
BACKEND_API_BASE_URL=http://localhost:4000
# Fallback compativel com specs futuras que usem nome publico
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Outras variáveis públicas de configuração
# NEXT_PUBLIC_OTHER=
