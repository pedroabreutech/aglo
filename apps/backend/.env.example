PORT= # Porta do servidor
MANAGEMENT_PORT= # healthcheck port
NODE_ENV= # Ambiente do servidor
CORS_ALLOWED_ORIGINS= # Origens permitidas para o CORS
APP_PUBLIC_URL= # URL publica da API (usada no "servers" do Swagger). Ex: https://api.aglo.example.com

DATABASE_URL= # URL do banco de dados (role de runtime da app)
MIGRATE_DATABASE_URL= # URL do banco de dados usada apenas pelo `prisma migrate deploy` (role de migration)
POSTGRES_PORT=5432 # Porta local exposta pelo Docker Compose
POSTGRES_DB=aglo # Banco local do Docker Compose
POSTGRES_USER=postgres # Usuario local do Docker Compose
POSTGRES_PASSWORD=postgres # Senha local do Docker Compose

AWS_ACCESS_KEY_ID= # Access key do Object Storage
AWS_SECRET_ACCESS_KEY= # Secret key do Object Storage
AWS_REGION=br-se1 # Regiao do bucket
AWS_ENDPOINT_URL=https://br-se1.magaluobjects.com # Endpoint S3 compativel da Magalu Cloud
S3_BUCKET=aglo-dev # Nome do bucket ja existente
STORAGE_SIGNED_URL_TTL_SECONDS=900 # 15 minutos

P2PNET_BASE_URL=http://127.0.0.1:8001 # URL base do servico P2Pnet
P2PNET_TIMEOUT_MS=300000 # Timeout da chamada ao P2Pnet (5 min)
P2PNET_DEFAULT_THRESHOLD=0.5 # Threshold padrao do P2Pnet
P2PNET_DEFAULT_WEIGHT_PATH=./weights/SHTechA.pth # Caminho padrao dos pesos no servico P2Pnet
